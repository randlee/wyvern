{
  "type": "wizard",
  "page": {
    "id": "sources",
    "title": "Choose paths",
    "html": "pages/sources.html"
  },
  "config": {
    "seed_paths": {
      "file_paths": ["/abs/path/to/file.csproj"],
      "folder_paths": ["/abs/path/to/root"]
    },
    "dataflow": {
      "version": 1,
      "pages": {
        "sources": {
          "exports": {
            "file_paths": "array",
            "folder_paths": "array"
          }
        },
        "review": {
          "requires": ["file_paths", "folder_paths"],
          "terminal": true,
          "exports": {
            "file_paths": "array",
            "folder_paths": "array"
          }
        }
      }
    }
  },
  "width": 720,
  "height": 520
}
