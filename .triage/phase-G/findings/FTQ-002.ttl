<urn:atm:triage:finding/FTQ-002>
  a triage:Finding ;
  triage:findingId "FTQ-002" ;
  triage:title "WYVERN_SHARE leak breaks extension help when invalid path set" ;
  triage:description "Like FTQ-001, the wyvern() test helper does not clear WYVERN_SHARE. When an invalid path is set in WYVERN_SHARE, it breaks extension help output during --help before the extension dispatch stage in g.1, causing test failures and integration issues." ;
