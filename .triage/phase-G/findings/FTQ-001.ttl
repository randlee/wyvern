<urn:atm:triage:finding/FTQ-001>
  a triage:Finding ;
  triage:findingId "FTQ-001" ;
  triage:title "help_surface.rs wyvern() only removes WYVERN_LOG; WYVERN_VIEWER leak breaks --help before dispatch" ;
  triage:description "The wyvern() test helper in help_surface.rs removes only WYVERN_LOG via env_remove(). Other environment variables like WYVERN_VIEWER are not cleared, causing them to leak across test cases and potentially break --help output before command dispatch in g.1." ;
  triage:triageMode "initial_pass" ;
