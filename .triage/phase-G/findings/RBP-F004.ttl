<urn:atm:triage:finding/RBP-F004>
  a triage:Finding ;
  triage:findingId "RBP-F004" ;
  triage:title "preexec.requires / SkillRequire.binary should be BinaryName newtype (mod.rs:262)" ;
  triage:description "PreexecSpec.requires and SkillRequire.binary are defined as String (mod.rs line 262 and catalog.rs). Per RBP best practices and ADR-0011 (type safety), these should use a BinaryName newtype that validates binary names are non-empty and provides consistent typing for command-line executable references." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-G" ;
  triage:severity "minor" ;
  triage:repeatable false ;
